# 이 파일을 .env로 복사해 값을 채웁니다. .env는 절대 커밋하지 않습니다.
# 배포 시 Secret 표시 항목은 Kubernetes Secret, 나머지는 ConfigMap에 둡니다.

# [Secret] PostgreSQL 연결 문자열
#  개발: Supabase 대시보드 Connect → Session pooler 주소 (팀 채널에서 받기)
#  배포: Amazon RDS 앱 전용 계정 (Kubernetes Secret)
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/postgres?sslmode=require
# [Secret] JWT 서명 키
JWT_SECRET=changeme

# LLM 실패 전환 순서 (AD-1): 앞 업체 실패 시 다음 업체
LLM_PROVIDER_ORDER=claude,gemini,groq
# 업체별 모델 (Q-5에서 결정)
CLAUDE_MODEL=
GEMINI_MODEL=
GROQ_MODEL=
# [Secret] 업체별 API 키 (키가 비어 있는 업체는 건너뜀)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT=60

# 메일: ses 또는 smtp (Q-8)
MAIL_PROVIDER=ses
MAIL_FROM=
AWS_REGION=ap-northeast-2
# [Secret] Gmail SMTP 대체 시
SMTP_USER=
SMTP_PASSWORD=

# 메일 맨 아래 서비스 링크
APP_BASE_URL=http://localhost:5173
